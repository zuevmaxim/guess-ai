{
  "name": "guess-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "dotenv": "^16.4.5",
    "openai": "^4.57.0"
  },
  "devDependencies": {
    "esbuild": "^0.23.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.6",
    "typescript": "^5.6.3"
  },
  "ts-node": {
    "esm": true,
    "transpileOnly": true
  },
  "scripts": {
    "start": "tsx src/server.ts",
    "build": "esbuild src/server.ts --bundle --platform=node --outfile=dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "TS_NODE_PROJECT=tsconfig.test.json node --loader ts-node/esm --test tests/**/*.test.ts"
  }
}
